meta {
  name: 01 Register USER
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{userName}}",
    "email": "user@example.com",
    "password": "{{userPassword}}"
  }
}

docs {
  Ожидается HTTP 201. Создаёт USER. Для повторного выполнения выбери новое значение userName в переменных коллекции.
}
