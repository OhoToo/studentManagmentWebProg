meta {
  name: 04 Create student
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/requests
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "fullName": "Ivanov Ivan",
    "group": "p3223",
    "ISU": "123456",
    "dormNumber": 8,
    "room": 101,
    "dateArrived": "2026-09-01",
    "isForeign": false,
    "notes": ""
  }
}

docs {
  Ожидается HTTP 201. Скопируй ID созданного студента в studentId в переменных коллекции.
}
