meta {
  name: 02 Login USER
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{userName}}",
    "password": "{{userPassword}}"
  }
}

docs {
  Ожидается HTTP 200. Скопируй accessToken в userToken, а refreshToken в refreshToken в переменных коллекции.
}
